# Copy to .env. Keep real credentials out of source control.
NODE_ENV=development
# Public origin of the app, with no trailing slash. The API rejects write
# requests whose Origin header does not match this value exactly, so on a
# deployment this MUST be the live https:// address, not localhost.
APP_URL=http://localhost:3000

# ------------------------------------------------------------------ topology
# `npm start` runs ONE process that serves the storefront and the API together
# on PORT. That is the deployable shape: managed Node.js hosting gives you a
# single process on a single assigned port and will not let the app open
# another. Leave the next three blank on such a host -- it sets PORT itself,
# and the defaults are correct.
#
# Port the app listens on. Blank means 3000, and a managed host overrides it.
PORT=
# Interface to bind. Blank binds 0.0.0.0 in production, which is required for a
# reverse proxy to reach the process, and loopback in development.
HOST=
# Set only to run the API as a SEPARATE service from the web server. Then the
# API process needs --api-only (or SERVE_WEB=false), and this is the address
# the web server reaches it on, for example http://127.0.0.1:3001. Blank means
# one process serves both, so no proxy is involved.
API_ORIGIN=
# Development only: the port `npm run dev` gives next dev. The dev stack runs
# the split topology because next dev owns hot reloading; it wires API_ORIGIN
# and --api-only for its own children, so neither needs setting here.
WEB_PORT=3000
# DATABASE_URL and DATA_DIR used to configure PostgreSQL and are gone. MongoDB
# is the only database; see MONGODB_URI below. They are named here only because
# a deployment that still carries them should drop them -- nothing reads them.
STORE_CURRENCY=INR
# Local fallback for admin image uploads, used only when Cloudinary is unset.
UPLOAD_DIR=uploads

# Cloudinary image hosting. Set all three to send admin uploads there instead
# of local disk; leave blank to keep writing to UPLOAD_DIR. The API secret
# signs upload requests server-side and is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder every upload is filed under in the media library.
CLOUDINARY_FOLDER=
# Set to the exact trusted reverse-proxy hop count in production, never blindly
# true. REQUIRED behind a managed host's proxy: with it unset every request
# appears to come from the proxy's address, so the per-IP rate limit in
# server/security.mjs throttles all customers as if they were one. One proxy in
# front of the app means 1.
TRUST_PROXY_HOPS=
# Whether the app process also drains the job queue on its own 5-second timer.
# Keep it true everywhere, including managed hosting: this is what makes a
# password-reset email arrive while the customer is still on the page.
#
# On managed hosting ALSO schedule `npm run worker:once` as a cron job every
# few minutes. That host does not keep background timers alive across idling
# and redeployment, so the timer needs a backstop. Running both is safe: jobs
# are claimed with an atomic lease, and every email carries an idempotency key
# to the provider, so no job runs twice and no email is delivered twice.
#
# Setting this false with no cron job means nothing drains the queue at all.
# Emails are then queued and never sent, with `attempts` stuck at 0.
RUN_WORKER=true

# Sessions use random, opaque, hashed database tokens, not JWTs.
# No shared authentication signing secret is required or used.

# Razorpay. Keep test and live credentials in separate .env files; never commit
# either. See docs/RAZORPAY_DASHBOARD_SETUP.md for what to configure where.
#
# 'test' or 'live'. Checked at startup against the key prefix, so a live key in
# test mode (or the reverse) refuses to boot rather than failing at the first
# real payment. Live mode additionally requires NODE_ENV=production.
RAZORPAY_MODE=test
# rzp_test_... in test mode, rzp_live_... in live mode.
RAZORPAY_KEY_ID=
# Server-side only. Never sent to the browser.
RAZORPAY_KEY_SECRET=
# A SEPARATE value you set on the webhook in the Razorpay dashboard. It is not
# the API key secret, and startup fails if the two match. Required whenever
# keys are set: without it a captured payment whose browser callback never
# arrives would never be reconciled.
RAZORPAY_WEBHOOK_SECRET=
# Optional old secret during a webhook secret rotation. Both are accepted while
# this is set, so a rotation needs no downtime.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# ------------------------------------------------- transactional email (Resend)
# See docs/RESEND_EMAIL_INTEGRATION.md for the domain and DNS setup.
#
# Both the key and a from-address are required before anything can be sent, and
# production refuses to start without them.
RESEND_API_KEY=
# The sender. MUST be on a domain you have verified in Resend — a free mailbox
# (gmail.com, outlook.com, ...) cannot be verified and will be rejected.
# Accepts a bare address or "Display Name <address>".
RESEND_FROM_EMAIL=
# Display name shown beside the address. Defaults to GEMIES.
RESEND_FROM_NAME=GEMIES
# EMAIL_FROM is the former name for RESEND_FROM_EMAIL and still works. Set one
# or the other, not both.
EMAIL_FROM=
# Where operator notifications go: new paid orders, payments needing attention,
# cancellations, refunds, and integration errors. Leave empty to switch admin
# notifications off; nothing else is affected.
ADMIN_NOTIFICATION_EMAIL=
# Link base for every email. Alias of APP_URL above; set either one.
APP_BASE_URL=

# Shiprocket API user credentials, not the primary account login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Optional courier selection. Blank lets Shiprocket select where supported.
SHIPROCKET_COURIER_ID=
# Manual paid-order fulfillment is the default. Enable only after staging verification.
AUTO_FULFILL=false
# Verified packed-order defaults. Admin can override per order before fulfillment.
PACKAGE_WEIGHT_KG=
PACKAGE_LENGTH_CM=
PACKAGE_BREADTH_CM=
PACKAGE_HEIGHT_CM=

# Required for issuing real invoices. Never enter invented legal details.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_TAX_ID=
BUSINESS_REGISTRATION=
