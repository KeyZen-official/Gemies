# Copy to .env. Keep real credentials out of source control.
NODE_ENV=development
# Public origin of the Next.js app. The API rejects write requests whose
# Origin header does not match this value exactly.
APP_URL=http://localhost:3000
# Port for the Next.js web server.
WEB_PORT=3000
# Port for the Express API. Next.js proxies /api and /uploads to it.
PORT=3001
HOST=127.0.0.1
# Where Next.js reaches the API. Defaults to http://127.0.0.1:3001.
# Set this whenever you change PORT above, or if the API runs on another host.
API_ORIGIN=
# Required in production. Use a PostgreSQL URL with your provider's verified TLS settings.
DATABASE_URL=
# Persistent embedded PostgreSQL for local development only; one API process owns it.
DATA_DIR=.data/db
STORE_CURRENCY=INR
# Local fallback for admin image uploads, used only when Cloudinary is unset.
UPLOAD_DIR=uploads

# Cloudinary image hosting. Set all three to send admin uploads there instead
# of local disk; leave blank to keep writing to UPLOAD_DIR. The API secret
# signs upload requests server-side and is never sent to the browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder every upload is filed under in the media library.
CLOUDINARY_FOLDER=
# Set to the exact trusted reverse-proxy hop count in production, never blindly true.
TRUST_PROXY_HOPS=
# In production you may disable the API's worker and run npm run worker separately.
RUN_WORKER=true

# Sessions use random, opaque, hashed database tokens, not JWTs.
# No shared authentication signing secret is required or used.

# Razorpay. Keep test and live credentials in separate .env files; never commit
# either. See docs/RAZORPAY_DASHBOARD_SETUP.md for what to configure where.
#
# 'test' or 'live'. Checked at startup against the key prefix, so a live key in
# test mode (or the reverse) refuses to boot rather than failing at the first
# real payment. Live mode additionally requires NODE_ENV=production.
RAZORPAY_MODE=test
# rzp_test_... in test mode, rzp_live_... in live mode.
RAZORPAY_KEY_ID=
# Server-side only. Never sent to the browser.
RAZORPAY_KEY_SECRET=
# A SEPARATE value you set on the webhook in the Razorpay dashboard. It is not
# the API key secret, and startup fails if the two match. Required whenever
# keys are set: without it a captured payment whose browser callback never
# arrives would never be reconciled.
RAZORPAY_WEBHOOK_SECRET=
# Optional old secret during a webhook secret rotation. Both are accepted while
# this is set, so a rotation needs no downtime.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# ------------------------------------------------- transactional email (Resend)
# See docs/RESEND_EMAIL_INTEGRATION.md for the domain and DNS setup.
#
# Both the key and a from-address are required before anything can be sent, and
# production refuses to start without them.
RESEND_API_KEY=
# The sender. MUST be on a domain you have verified in Resend — a free mailbox
# (gmail.com, outlook.com, ...) cannot be verified and will be rejected.
# Accepts a bare address or "Display Name <address>".
RESEND_FROM_EMAIL=
# Display name shown beside the address. Defaults to GEMIES.
RESEND_FROM_NAME=GEMIES
# EMAIL_FROM is the former name for RESEND_FROM_EMAIL and still works. Set one
# or the other, not both.
EMAIL_FROM=
# Where operator notifications go: new paid orders, payments needing attention,
# cancellations, refunds, and integration errors. Leave empty to switch admin
# notifications off; nothing else is affected.
ADMIN_NOTIFICATION_EMAIL=
# Link base for every email. Alias of APP_URL above; set either one.
APP_BASE_URL=

# Shiprocket API user credentials, not the primary account login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=
# Optional courier selection. Blank lets Shiprocket select where supported.
SHIPROCKET_COURIER_ID=
# Manual paid-order fulfillment is the default. Enable only after staging verification.
AUTO_FULFILL=false
# Verified packed-order defaults. Admin can override per order before fulfillment.
PACKAGE_WEIGHT_KG=
PACKAGE_LENGTH_CM=
PACKAGE_BREADTH_CM=
PACKAGE_HEIGHT_CM=

# Required for issuing real invoices. Never enter invented legal details.
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_TAX_ID=
BUSINESS_REGISTRATION=
